# Configuration pour la plateforme SMS Marketing - Côte d'Ivoire

# Clés API des opérateurs (à obtenir auprès des opérateurs)
ORANGE_API_KEY=your_orange_api_key_here
MTN_API_KEY=your_mtn_api_key_here
MOOV_API_KEY=your_moov_api_key_here

# Configuration de la base de données
DATABASE_URL=sms_marketing.db

# Configuration Flask
FLASK_SECRET_KEY=your_super_secret_key_here
FLASK_ENV=development

# Configuration SMS
DEFAULT_SMS_PROVIDER=orange
SMS_RATE_LIMIT=1000

# Configuration de sécurité
ENCRYPT_PHONE_NUMBERS=true
LOG_ALL_ACTIVITIES=true

# Configuration des notifications
EMAIL_NOTIFICATIONS=true
SMS_NOTIFICATIONS=true
LOW_BALANCE_THRESHOLD=1000

# Configuration du marché ivoirien
CURRENCY=FCFA
TIMEZONE=Africa/Abidjan
DEFAULT_LANGUAGE=fr

# Configuration des webhooks
WEBHOOK_DELIVERY_REPORTS=true
WEBHOOK_OPT_OUT=true
