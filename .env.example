# Copiez ce fichier en .env et renseignez vos valeurs réelles.
# NE JAMAIS committer le fichier .env dans Git.

# Ce fichier est prévu pour le déploiement Docker Compose. En développement
# local (flask run), n'utilisez pas de .env : les valeurs par défaut suffisent.

# --- Application ---
FLASK_ENV=production
# Générez chaque clé avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
# Le profil production refuse de démarrer avec les valeurs d'exemple ci-dessous.
SECRET_KEY=change-moi
JWT_SECRET_KEY=change-moi

# --- Adresse publique ---
# Nom de domaine pointant vers le serveur (ex: app.baoryx.ci) : Caddy obtient
# un certificat HTTPS automatiquement. Une adresse IP fonctionne aussi pour un
# test (certificat interne, avertissement du navigateur à accepter).
DOMAIN=app.baoryx.ci

# --- Base de données (conteneur PostgreSQL) ---
# docker-compose construit DATABASE_URL à partir de ces trois valeurs.
POSTGRES_USER=baoryx
POSTGRES_PASSWORD=change-moi-mot-de-passe-postgres
POSTGRES_DB=baoryx

# --- Fournisseur SMS : console | africastalking | orange | twilio ---
SMS_PROVIDER=console
SMS_SENDER_ID=BAORYX
SMS_COST_CREDITS=1
FREE_TRIAL_CREDITS=20

# Africa's Talking (recommandé pour la Côte d'Ivoire — multi-opérateurs)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# Orange SMS API
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=

# Twilio (secours international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Paiement / Mobile Money : manual | cinetpay ---
PAYMENT_PROVIDER=manual
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# --- Divers ---
# Doit rester à true dès que le site est servi en HTTPS (cas du docker-compose).
# false uniquement pour un test en HTTP sans certificat : les cookies de
# session circulent alors en clair.
SESSION_COOKIE_SECURE=true
# Seuil (en crédits) sous lequel le tableau de bord signale un solde faible.
LOW_BALANCE_THRESHOLD=50
MAIL_SUPPORT_ADDRESS=support@baoryx.ci
