# Copiez ce fichier en .env et renseignez vos valeurs réelles.
# NE JAMAIS committer le fichier .env dans Git.

# --- Application ---
FLASK_ENV=production
SECRET_KEY=change-moi-avec-une-valeur-aleatoire-longue
JWT_SECRET_KEY=change-moi-aussi

# --- Base de données ---
# En production, utilisez PostgreSQL (Docker Compose le fournit déjà).
DATABASE_URL=postgresql://baoryx:baoryx@db:5432/baoryx

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Fournisseur SMS : console | africastalking | orange | twilio ---
SMS_PROVIDER=console
SMS_SENDER_ID=BAORYX
SMS_COST_CREDITS=1
FREE_TRIAL_CREDITS=20

# Africa's Talking (recommandé pour la Côte d'Ivoire — multi-opérateurs)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# Orange SMS API
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=

# Twilio (secours international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Paiement / Mobile Money : manual | cinetpay ---
PAYMENT_PROVIDER=manual
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# --- Divers ---
SESSION_COOKIE_SECURE=true
MAIL_SUPPORT_ADDRESS=support@baoryx.ci
